{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Documentation - VuArchives",
  "colors": {
    "primary": "#887BF6",
    "light": "#887BF6",
    "dark": "#887BF6"
  },
  "appearance": {
    "default": "dark"
  },
  "styling": {
    "codeblocks": "system",
    "eyebrows": "breadcrumbs"
  },
  "favicon": "/logo.webp",
  "errors": {
    "404": {
      "redirect": false
    }
  },
  "interaction": {
    "drilldown": false
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Home",
            "pages": [
              "docs/intro"
            ]
          },
          {
            "group": "Quick Start",
            "pages": [
              "docs/quick-start/overview-of-vuarchives",
              "docs/quick-start/pricing-comparsion"
            ]
          },
          {
            "group": "Historical Services",
            "pages": [
              "docs/historical-services/historical-room-viewer",
              "docs/historical-services/spouse-history",
              "docs/historical-services/time-tracker"

            ]
          },
          {
            "group": "Premium Tools",
            "pages": [
              "docs/premium-tools/private-room-scanner",
              "docs/premium-tools/auto-private-room-tracker",
              "docs/premium-tools/product-extractor",
              "docs/premium-tools/pose-maker"            
            ]
          },
          {
            "group": "How 2 Guide",
            "pages": [
              "docs/how2guide/account-creation",
              "docs/how2guide/account-deletion",
              "docs/how2guide/webhooks"
            ]
          },
          {
            "group": "Legal",
            "pages": [
              "docs/legal/terms",
              "docs/legal/privacy-policy"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/docs",
      "destination": "/docs/intro"
    },
    {
      "source": "/docs/",
      "destination": "/docs/intro"
    },
    {
      "source": "/docs/index",
      "destination": "/docs/intro"
    }
  ],
  "logo": {
    "light": "/light.svg",
    "dark": "/logo.webp",
    "href": "https://docs.vuarchives.com"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#111419"
    }
  },
  "api": {
    "playground": {
      "display": "simple"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Contact Us",
        "href": "https://vuarchives.com/contact.php"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Homepage",
      "href": "https://vuarchives.com"
    }
  },
  "banner" : {
    "content": "Don't worry more guides will be added soon!",
    "dismissible": true
  },
"seo": {
    "metatags": {
        "og:title": "VuArchives Documentation",
        "og:description": "Whether you’re a new or an existing member of our platform, we’ve got you covered!",
        "og:image": "/images/embed.png",
        "theme-color": "#8179FD",
        "canonical": "https://www.vuarchives.com"
    }
  }
}